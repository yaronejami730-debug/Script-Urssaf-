# Clé Stripe RESTREINTE : droits Balance (lecture) + Payouts (écriture) uniquement
STRIPE_SECRET_KEY=
# Secret pour protéger le cron (chaîne aléatoire)
CRON_SECRET=
# IDs des comptes bancaires de versement (ba_...), optionnels (sinon compte par défaut)
PAYOUT_DESTINATION_URSSAF=
PAYOUT_DESTINATION_NET=
CURRENCY=eur
# % du solde Stripe viré en fin de mois
URSSAF_PCT=30
# jours ouvrés d'avance pour que l'argent arrive à temps (Stripe: ~2 jours ouvrés)
LEAD_BUSINESS_DAYS=3
MIN_PAYOUT_CENTS=100
# true = calcule et log, ne vire rien
DRY_RUN=true

# --- Remboursement de la dette URSSAF ---
# Cible à atteindre en centimes (100000 = 1000 €). 0 = désactivé
DEBT_TARGET_CENTS=100000
# % du CA encaissé mis en réserve en plus des 30 %
DEBT_PCT=15
# Réserve déjà constituée au départ, en centimes
DEBT_RESERVE_START_CENTS=0
# Date de début du suivi (AAAA-MM-JJ). Par défaut : 1er du mois courant
START_DATE=

# --- Provision impôt sur le revenu ---
TAX_ENABLED=true
# Abattement forfaitaire : 34 (BNC), 50 (BIC services), 71 (vente)
TAX_ABATEMENT_PCT=34
# Nombre de parts du foyer fiscal
TAX_PARTS=1
# Autres revenus imposables du foyer sur l'année, en centimes (salaires nets imposables...)
TAX_OTHER_INCOME_CENTS=0
# CA brut déjà encaissé cette année avant le début du suivi, en centimes
YTD_START_CENTS=0
# Mois du virement "impôts" (12 = décembre)
TAX_PAYOUT_MONTH=12
# Foyer en couple (décote différente) : true/false
TAX_COUPLE=false
